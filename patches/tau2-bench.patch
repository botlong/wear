 # Context variable to store the LLM logging mode ("all" or "latest")
 llm_log_mode: ContextVar[str] = ContextVar("llm_log_mode", default="latest")
 
+
+def _env_json(name: str):
+    """WEAR patch: parse a JSON-valued env var; fail fast (naming the var) on
+    malformed JSON — skipping silently could route calls to the wrong endpoint
+    or drop required fields. Returns None when unset."""
+    raw = os.getenv(name)
+    if raw is None:
+        return None
+    try:
+        return json.loads(raw)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"invalid JSON in env {name}: {raw[:80]!r}") from e
+
+
+_THROTTLE_LOCK = threading.Lock()
+_THROTTLE_LAST: dict = {}
+
+
+def _throttle(model: str) -> None:
+    """WEAR patch: enforce a per-model minimum call interval
+    (env TAU2_LLM_MIN_INTERVAL_S, JSON {full model string: seconds}).
+    In-process throttle for rate-limited endpoints; does not wrap litellm's
+    retry path, but throttled first calls rarely need retries. Off by default."""
+    mi = _env_json("TAU2_LLM_MIN_INTERVAL_S")
+    if not mi:
+        return
+    try:
+        gap = float(mi.get(model) or 0)
+    except (TypeError, ValueError) as e:
+        raise ValueError(
+            f"TAU2_LLM_MIN_INTERVAL_S[{model}] must be a number") from e
+    if gap <= 0:  # zero/negative means unconfigured; avoid a half-enabled state
+        return
+    while True:
+        with _THROTTLE_LOCK:
+            now = time.monotonic()
+            wait = _THROTTLE_LAST.get(model, 0.0) + float(gap) - now
+            if wait <= 0:
+                _THROTTLE_LAST[model] = now
+                return
+        time.sleep(min(wait, 1.0))
+
